VITE_API_URL=http://localhost:3000

# Cashfree checkout environment for local dev. Use "sandbox" so you don't charge
# real cards while testing; the API must also point at sandbox keys for this to work.
VITE_CASHFREE_MODE=sandbox

# ── EmailJS — get credentials at https://emailjs.com (free, 200 emails/month) ──
# VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
# VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
# VITE_EMAILJS_TEMPLATE_ORDER=template_xxxxxxx     # New order alert
# VITE_EMAILJS_TEMPLATE_STOCK=template_xxxxxxx     # Low stock alert
# VITE_EMAILJS_TEMPLATE_CUSTOMER=template_xxxxxxx  # New customer registration
# VITE_EMAILJS_TEMPLATE_REPORT=template_xxxxxxx    # Daily sales report
